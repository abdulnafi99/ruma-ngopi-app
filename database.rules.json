{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "store": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$memberId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$memberId.matches(/^[0-9]{12}$/)"
      }
    },

    "orders": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'memberId' && query.equalTo != null))",
      ".indexOn": ["memberId", "ts"],
      "$no": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['no', 'ts', 'memberId', 'items', 'total', 'status'])"
      }
    },

    "vouchers": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'id' && query.equalTo != null))",
      ".indexOn": ["id", "ts"],
      "$code": { ".write": "auth != null" }
    },

    "counters": {
      "orderNo": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
      }
    }
  }
}
